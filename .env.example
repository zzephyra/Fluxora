# Local development only. Do not put production secrets here.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Host-side API (make run). Compose sets the API container URL to the postgres service.
DATABASE_URL=postgresql+asyncpg://fluxora:fluxora@localhost:5432/fluxora
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Production and staging must set CSRF_SECRET (at least 32 characters)
# and CORS_ALLOWED_ORIGINS. Development uses local defaults when unset.
# Comma-separated names of server-side model secrets. Do not put secret values here.
# MODEL_SECRET_REFS=qianwen
# JSON object of those names to an https base URL and API key. Do not commit real keys.
# MODEL_ENDPOINTS={"qianwen":{"base_url":"https://example.com/v1","api_key":"replace-me"}}
# User uploads go directly to Qiniu. Leave these empty until the bucket is ready.
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=
# QINIU_REGION=z2
# QINIU_UPLOAD_TOKEN_TTL_SECONDS=3600
# IMAGE_MAX_SIZE=20971520
# VIDEO_MAX_SIZE=536870912
# FILE_MAX_SIZE=52428800

# Public canonical URL for Lumi metadata; does not change API/OAuth endpoints.
VITE_SITE_URL=https://lumisene.com
